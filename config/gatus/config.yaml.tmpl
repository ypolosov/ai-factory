# Проверки доступности (Gatus). scripts/stand-up.sh подставляет токен учётки эксплуатации,
# дописывает по проверке на каждое приложение стенда из DEPLOY_APPS (app-endpoint.yaml.tmpl)
# и кладёт результат в .state/gatus/config.yaml. Упавшая проверка приложения сама заводит
# задачу в его репозитории и закрывает её, когда приложение снова отвечает.
storage:
  type: memory
ui:
  title: Стенд фабрики
alerting:
  gitea:
    # Репозиторий по умолчанию; у каждого приложения - свой (provider-override).
    repository-url: "http://forgejo:3000/@ALERT_REPO@"
    token: "@OPS_TOKEN@"
endpoints:
  - name: forgejo
    group: фабрика
    url: "http://forgejo:3000/api/healthz"
    interval: 30s
    conditions:
      - "[STATUS] == 200"
