#!/bin/sh
# Шаг задания агента на любом исполнителе заданий (Bitbucket Pipelines и др.): берёт у
# посредника координатора задачу, рабочую копию и ключи, запускает factory-agent и сдаёт итог.
#
# Вход:  BROKER_URL, RUN_TOKEN - разовый ключ запуска (у исполнителя - скрытая переменная).
#        Вид задания - FACTORY_JOB от посредника: agent (по умолчанию), judge (судья PR),
#        design (сверка макета), scan (сканеры изменения PR). FACTORY_MOCKUP - у агента есть
#        принятый макет экрана задачи.
# Выход: agent.patch, run.json, agent.log, secrets.json (находки Gitleaks в добавленных строках,
#        значения скрыты), tests.json (тест до кода) и код агента - у посредника; код шага = код агента.
# Ключи шага (подписка, шлюз) приходят только от посредника, не печатаются и живут в окружении
# этого процесса; недоверенный код получает их через factory-agent и factory-untrusted.
set -eu
: "${BROKER_URL:?}" "${RUN_TOKEN:?}"

umask 077
work=$(mktemp -d)
# Рабочую копию правит пользователь node: каталог проходим, но не читаем.
chmod 711 "$work"
printf 'Authorization: Bearer %s\n' "$RUN_TOKEN" >"$work/auth"
unset RUN_TOKEN
broker() { curl -fsS --noproxy '*' -H @"$work/auth" "$@"; }

broker -o "$work/env.json" "$BROKER_URL/v1/env"
broker -o "$work/task.md" "$BROKER_URL/v1/task"
eval "$(jq -r 'to_entries[] | select(.key | test("^[A-Z][A-Z0-9_]*$")) | "export \(.key)=\(.value | @sh)"' "$work/env.json")"
rm -f "$work/env.json"
mkdir -p "$work/out"

# upload ФАЙЛ... - сдать файлы итога посреднику (каких нет - пропустить).
upload() {
	for f in "$@"; do
		[ ! -f "$work/out/$f" ] || broker -X PUT --data-binary @"$work/out/$f" "$BROKER_URL/v1/files/$f"
	done
}
finish() {
	broker -X POST -H 'content-type: application/json' --data "{\"exit_code\":$1}" "$BROKER_URL/v1/done"
	echo "задание ${FACTORY_JOB:-agent} закончено с кодом $1"
	exit "$1"
}

case ${FACTORY_JOB:-agent} in
judge)
	# Судья PR: дифф - вход проверки, ответ - JSON по схеме судьи (factory-judge).
	broker -o "$work/input.patch" "$BROKER_URL/v1/input"
	set +e
	GATEWAY_KEY=$GATEWAY_KEY_SUB factory-judge "$FACTORY_EXECUTOR" "$FACTORY_MODEL" "$work/task.md" "$work/input.patch" \
		"$work/out/result.json" 2>"$work/out/agent.log"
	rc=$?
	set -e
	upload result.json agent.log codex-auth.json
	finish "$rc"
	;;
design)
	# Сверка макета: картинка макета - вход проверки, требования - в задаче (factory-design).
	broker -o "$work/input.png" "$BROKER_URL/v1/input"
	set +e
	GATEWAY_KEY=$GATEWAY_KEY_SUB factory-design "$FACTORY_MODEL" "$work/task.md" "$work/input.png" "$work/out/result.json" 2>"$work/out/agent.log"
	rc=$?
	set -e
	upload result.json agent.log codex-auth.json
	finish "$rc"
	;;
scan)
	# Сканеры изменения PR: вход - дифф и файлы блокировки на общем предке и на голове.
	broker -o "$work/input.json" "$BROKER_URL/v1/input"
	set +e
	factory-scan "$work/input.json" "$work/out/result.json" 2>"$work/out/agent.log"
	rc=$?
	set -e
	upload result.json agent.log
	finish "$rc"
	;;
esac

broker -o "$work/repo.bundle" "$BROKER_URL/v1/repo"
git clone -q "$work/repo.bundle" "$work/repo"
# Принятый макет экрана (FACTORY_MOCKUP от посредника) - рядом с заданием, вне рабочей копии:
# в коммит агента он не попадёт.
set --
if [ -n "${FACTORY_MOCKUP:-}" ]; then
	broker -o "$work/mockup.png" "$BROKER_URL/v1/mockup"
	set -- --mockup "$work/mockup.png"
fi

set +e
(cd "$work/repo" && factory-agent --task "$work/task.md" --out "$work/out" "$@")
rc=$?
set -e
# Секреты в добавленных строках патча: правила Gitleaks фабрики, значения в отчёте скрыты.
if [ -s "$work/out/agent.patch" ]; then
	grep '^+' "$work/out/agent.patch" | grep -v '^+++' |
		gitleaks stdin --no-banner --redact --exit-code 0 --config /etc/factory/checks/gitleaks.toml \
			--report-format json --report-path "$work/out/secrets.json" >/dev/null 2>&1 || true
fi
# Тест до кода: модульные тесты изменения падают на коде базы и проходят с изменением. Доработка
# (REWORK_BASE): база - общий предок ветки PR и ветки по умолчанию, изменение - вся ветка вместе с
# доработкой (патч агента уже выгружен в agent.patch и от этого не меняется).
if [ -s "$work/out/agent.patch" ]; then
	# Рабочая копия принадлежит недоверенному пользователю (factory-untrusted) - git от его имени.
	[ -z "${REWORK_BASE:-}" ] || (cd "$work/repo" && factory-untrusted git reset -q --soft "$REWORK_BASE") ||
		echo "тест до кода: не вышло встать на общий предок $REWORK_BASE - сравнение с прошлой попыткой" >>"$work/out/agent.log"
	(cd "$work/repo" && factory-test-first "$work/out/tests.json") 2>>"$work/out/agent.log" || true
fi
upload agent.patch run.json agent.log secrets.json tests.json
finish "$rc"
