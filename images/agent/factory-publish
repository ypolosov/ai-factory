#!/bin/sh
# Публикация результата агента: проверка патча и PR от имени бота.
# Работает в отдельном задании без ключа модели; токен записи - только здесь.
#
# Вход: --result КАТАЛОГ (agent.patch, run.json от factory-agent); FORGEJO_URL
#       (внутренний адрес), REPO (владелец/имя), ISSUE (номер), ISSUE_TITLE, BOT_TOKEN;
#       правила путей роли (из .factory/config.yml основной ветки): FACTORY_PROTECTED_PATHS -
#       префиксы, которые менять нельзя (по умолчанию .forgejo/ .github/ .factory/),
#       FACTORY_ALLOWED_PATHS - если задан, менять можно только под этими префиксами.
# Выход: ветка agent/issue-НОМЕР и PR "Closes #НОМЕР".
set -eu

result=""
while [ $# -gt 0 ]; do
	case $1 in
	--result) result=$2 && shift 2 ;;
	*) echo "неизвестный аргумент: $1" >&2 && exit 2 ;;
	esac
done
[ -d "$result" ] || { echo "нужен --result КАТАЛОГ" >&2 && exit 2; }
result=$(cd "$result" && pwd)
: "${FORGEJO_URL:?}" "${REPO:?}" "${ISSUE:?}" "${ISSUE_TITLE:?}" "${BOT_TOKEN:?}"

patch=$result/agent.patch
branch=agent/issue-$ISSUE
run=$(cat "$result/run.json")
# Заголовок по роли: agent (разработка), spec (спецификация), tests (приёмочные тесты).
role=$(printf '%s' "$run" | jq -r '.role // "dev"')
prefix=$([ "$role" = dev ] && echo agent || echo "$role")

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
creds=$work/.git-credentials
host=${FORGEJO_URL#http://}
printf 'http://factory-bot:%s@%s\n' "$BOT_TOKEN" "$host" >"$creds"
chmod 600 "$creds"
printf 'Authorization: token %s\n' "$BOT_TOKEN" >"$work/auth.header"
chmod 600 "$work/auth.header"
git() { command git -c credential.helper="store --file=$creds" "$@"; }
gitbot() { git -c user.name=factory-bot -c user.email=bot@factory.local "$@"; }

# Доработка: ветка прошлой попытки уже есть - новый коммит поверх неё (агент
# работал в её копии, патч - относительно её головы).
rework=""
if git ls-remote --exit-code --heads "$FORGEJO_URL/$REPO.git" "$branch" >/dev/null 2>&1; then
	rework=1
fi

if [ ! -s "$patch" ]; then
	[ -n "$rework" ] || { echo "агент не внёс изменений - PR не нужен" >&2 && exit 1; }
	# Доработка без изменений: агент счёл, что менять нечего (например, проверки упали
	# не по его вине) - пустой коммит перезапускает проверки и считается кругом.
	git clone -q -b "$branch" "$FORGEJO_URL/$REPO.git" "$work/repo"
	gitbot -C "$work/repo" commit -q --allow-empty -m "$prefix: #$ISSUE доработка: изменений нет, повтор проверок"
	git -C "$work/repo" push -q origin "$branch"
	echo "доработка без изменений: проверки PR перезапущены"
	exit 0
fi

# Детерминированные ворота до любой записи. Пути - из всех заголовков патча,
# включая переименования и копирование.
protected=${FACTORY_PROTECTED_PATHS:-.forgejo/ .github/ .factory/}
allowed=${FACTORY_ALLOWED_PATHS:-}
violations=$(awk '/^diff --git a\// { s = $0; sub(/^diff --git a\//, "", s); i = index(s, " b/")
		print substr(s, 1, i - 1); print substr(s, i + 3) }
	/^(rename|copy) (from|to) / { sub(/^(rename|copy) (from|to) /, ""); print }' "$patch" | sort -u |
	while IFS= read -r f; do
		for pre in $protected; do
			case $f in "$pre"*) echo "  защищённый путь: $f" ;; esac
		done
		if [ -n "$allowed" ]; then
			ok=""
			for pre in $allowed; do
				case $f in "$pre"*) ok=1 ;; esac
			done
			[ -n "$ok" ] || echo "  вне разрешённых путей роли: $f"
		fi
	done)
if [ -n "$violations" ]; then
	printf 'патч отклонён:\n%s\n' "$violations" >&2
	exit 1
fi
lines=$(git apply --numstat "$patch" | awk '{ s += $1 + $2 } END { print s + 0 }')
[ "$lines" -le 3000 ] || { echo "патч слишком большой: $lines строк" >&2 && exit 1; }
bytes=$(wc -c <"$patch")
[ "$bytes" -le 1048576 ] || { echo "патч слишком большой: $bytes байт" >&2 && exit 1; }

if [ -n "$rework" ]; then
	git clone -q -b "$branch" "$FORGEJO_URL/$REPO.git" "$work/repo"
else
	git clone -q "$FORGEJO_URL/$REPO.git" "$work/repo"
fi
cd "$work/repo"
[ -n "$rework" ] || git switch -q -c "$branch"
git apply --check "$patch"
git apply --index "$patch"
msg="$prefix: #$ISSUE $ISSUE_TITLE"
[ -z "$rework" ] || msg="$prefix: #$ISSUE доработка по замечаниям"
gitbot commit -q -m "$msg"
if [ -n "$rework" ]; then
	git push -q origin "$branch"
else
	git push -q -f origin "$branch"
fi

body=$(jq -n --arg issue "$ISSUE" --argjson run "$run" \
	'"Closes #" + $issue + "\n\nРоль: " + ($run.role // "dev") + ", исполнитель: " + $run.executor
	+ ", модель: " + $run.model + ", задача шлюза: " + $run.task_id
	+ ", время: " + ($run.seconds | tostring) + " с."')
data=$(jq -n --arg head "$branch" --arg title "$prefix: $ISSUE_TITLE" --argjson body "$body" \
	'{head: $head, base: "main", title: $title, body: $body}')
code=$(curl -s -o "$work/pr.json" -w '%{http_code}' -X POST \
	-H @"$work/auth.header" -H 'Content-Type: application/json' \
	--data "$data" "$FORGEJO_URL/api/v1/repos/$REPO/pulls")
case $code in
201) echo "PR: $(jq -r .html_url "$work/pr.json")" ;;
409 | 422) echo "PR для $branch уже открыт - ветка обновлена" ;;
*)
	echo "не удалось открыть PR: HTTP $code $(cat "$work/pr.json")" >&2
	exit 1
	;;
esac
