#!/bin/sh
# Первые N байт по границе символа UTF-8: head -c режет многобайтный символ пополам, и модель
# отказывается читать такой текст. Обрезанный последний символ отбрасывается.
# Использование: factory-utf8-head N [ФАЙЛ]
n=${1:?использование: factory-utf8-head N [ФАЙЛ]}
shift
head -c "$n" "$@" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null
exit 0
