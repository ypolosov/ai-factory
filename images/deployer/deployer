#!/bin/sh
# Служба выкладки фабрики. Модель "забирает сама", как Argo CD и Flux: следит за main
# приложений и выкладывает новые коммиты на стенд.
#
#   deployer watch                      - следить за main приложений из DEPLOY_APPS
#   deployer deploy ПРИЛОЖЕНИЕ SHA      - собрать, проверить и выложить коммит
#   deployer rollback ПРИЛОЖЕНИЕ [ТЕГ]  - вернуть прошлый образ (или указанный тег)
#   deployer status ПРИЛОЖЕНИЕ          - что выложено сейчас и что было до этого
#
# Окружение: DOCKER_HOST - Docker стенда; FORGEJO_URL - внутренний адрес Forgejo;
# DEPLOY_APPS - "владелец/репозиторий=порт ..."; STAND_HOST - имя стенда в сети фабрики;
# STAND_PUBLIC_HOST - адрес стенда для людей; DEPLOY_INTERVAL - пауза опроса, с.
# Токен бота для статусов коммитов - /secrets/bot.token; адрес сбора ошибок приложения
# (DSN GlitchTip) - /secrets/dsn/ПРИЛОЖЕНИЕ; состояние - /state; кэш Trivy - /cache.
set -eu

: "${FORGEJO_URL:?}" "${DEPLOY_APPS:?}" "${STAND_HOST:?}" "${STAND_PUBLIC_HOST:=127.0.0.1}"
: "${DEPLOY_INTERVAL:=15}"
recipes=/etc/deployer/recipes
# Код фабрики, который рецепт добавляет в образ приложения (сбор ошибок).
runtime=/etc/deployer/runtime

log() { printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*"; }

# app_field ПРИЛОЖЕНИЕ repo|port - поле из DEPLOY_APPS; приложение - имя репозитория.
app_field() {
	for _e in $DEPLOY_APPS; do
		_repo=${_e%%=*}
		[ "${_repo##*/}" = "$1" ] || continue
		case $2 in
		repo) printf '%s' "$_repo" ;;
		port) printf '%s' "${_e#*=}" ;;
		esac
		return 0
	done
	return 1
}

api() {
	_m=$1
	_p=$2
	shift 2
	curl -fsS -X "$_m" -H @/tmp/auth.header -H 'Content-Type: application/json' "$FORGEJO_URL/api/v1$_p" "$@"
}

# commit_status РЕПОЗИТОРИЙ SHA СОСТОЯНИЕ ОПИСАНИЕ ПОРТ - статус "deploy / stand" на коммите.
commit_status() {
	jq -n --arg s "$3" --arg d "$4" --arg u "http://$STAND_PUBLIC_HOST:$5/" \
		'{state: $s, context: "deploy / stand", description: $d, target_url: $u}' >/tmp/status.json
	api POST "/repos/$1/statuses/$2" --data @/tmp/status.json >/dev/null || log "статус коммита не записан"
}

healthy() {
	_i=0
	until curl -fsS -o /dev/null "http://$STAND_HOST:$1/health" 2>/dev/null; do
		_i=$((_i + 1))
		[ "$_i" -le 30 ] || return 1
		sleep 1
	done
}

# run_image ПРИЛОЖЕНИЕ ТЕГ ПОРТ - поднять образ проектом compose на стенде. Ошибки
# приложения уходят в GlitchTip с версией - коммитом из тега.
run_image() {
	IMAGE=$2 STAND_PORT=$3 SENTRY_DSN=$(cat "/secrets/dsn/$1" 2>/dev/null || true) SENTRY_RELEASE=${2##*:} \
		docker compose -p "$1" -f "$recipes/app.compose.yml" up -d --remove-orphans >/dev/null 2>&1
}

# switch ПРИЛОЖЕНИЕ ТЕГ ПОРТ - выложить тег; не поднялся - вернуть текущий.
switch() {
	mkdir -p "/state/$1"
	_cur=$(cat "/state/$1/current" 2>/dev/null || true)
	run_image "$1" "$2" "$3" || true
	if healthy "$3"; then
		if [ -n "$_cur" ] && [ "$_cur" != "$2" ]; then
			printf '%s' "$_cur" >"/state/$1/previous"
		fi
		printf '%s' "$2" >"/state/$1/current"
		return 0
	fi
	if [ -n "$_cur" ]; then
		log "$1: $2 не прошёл проверку здоровья, возвращаю $_cur"
		run_image "$1" "$_cur" "$3" || true
	fi
	return 1
}

deploy() {
	app=$1
	sha=$2
	repo=$(app_field "$app" repo) || {
		log "нет приложения $app в DEPLOY_APPS"
		return 1
	}
	port=$(app_field "$app" port)
	tag="$app:$(printf '%s' "$sha" | cut -c1-12)"
	work=$(mktemp -d)
	git clone -q "$FORGEJO_URL/$repo.git" "$work/src"
	git -C "$work/src" checkout -q "$sha"
	if [ ! -f "$work/src/src/server.ts" ] && [ ! -f "$work/src/src/server.js" ]; then
		log "$app@$sha: нет src/server.ts или src/server.js - выкладывать нечего"
		rm -rf "$work"
		return 0
	fi
	commit_status "$repo" "$sha" pending "сборка и проверка образа" "$port"
	log "$app@$sha: сборка $tag"
	if ! docker build -q -f "$recipes/node.Dockerfile" --build-context "runtime=$runtime" -t "$tag" "$work/src" >/dev/null; then
		commit_status "$repo" "$sha" failure "сборка не прошла" "$port"
		rm -rf "$work"
		return 1
	fi
	docker save "$tag" -o "$work/image.tar"
	log "$app@$sha: Trivy"
	if ! trivy image --input "$work/image.tar" --cache-dir /cache/trivy --severity HIGH,CRITICAL \
		--ignore-unfixed --exit-code 1 --no-progress --quiet; then
		commit_status "$repo" "$sha" failure "Trivy: уязвимости HIGH или CRITICAL с исправлением" "$port"
		rm -rf "$work"
		return 1
	fi
	rm -rf "$work"
	if switch "$app" "$tag" "$port"; then
		commit_status "$repo" "$sha" success "на стенде: $tag" "$port"
		log "$app@$sha: на стенде http://$STAND_PUBLIC_HOST:$port/"
	else
		commit_status "$repo" "$sha" failure "не прошёл проверку здоровья; на стенде прежняя версия" "$port"
		return 1
	fi
}

rollback() {
	app=$1
	port=$(app_field "$app" port) || {
		log "нет приложения $app в DEPLOY_APPS"
		return 1
	}
	to=${2:-$(cat "/state/$app/previous" 2>/dev/null || true)}
	[ -n "$to" ] || {
		log "$app: откатываться не на что"
		return 1
	}
	docker image inspect "$to" >/dev/null 2>&1 || {
		log "$app: на стенде нет образа $to"
		return 1
	}
	log "$app: откат на $to"
	switch "$app" "$to" "$port" && log "$app: на стенде $to"
}

watch() {
	log "слежу за: $DEPLOY_APPS, раз в $DEPLOY_INTERVAL с"
	while :; do
		for _e in $DEPLOY_APPS; do
			_repo=${_e%%=*}
			_app=${_repo##*/}
			mkdir -p "/state/$_app"
			_sha=$(api GET "/repos/$_repo/branches/main" 2>/dev/null | jq -r '.commit.id // empty') || true
			[ -n "$_sha" ] || continue
			# Каждый коммит - одна попытка: неудачный ждёт следующего коммита или отката.
			[ "$_sha" = "$(cat "/state/$_app/seen" 2>/dev/null || true)" ] && continue
			printf '%s' "$_sha" >"/state/$_app/seen"
			deploy "$_app" "$_sha" || log "$_app@$_sha: не выложено"
		done
		sleep "$DEPLOY_INTERVAL"
	done
}

[ -s /secrets/bot.token ] || {
	log "нет /secrets/bot.token"
	exit 1
}
printf 'Authorization: token %s\n' "$(cat /secrets/bot.token)" >/tmp/auth.header
chmod 600 /tmp/auth.header

cmd=${1:-watch}
[ $# -eq 0 ] || shift
case $cmd in
watch) watch ;;
deploy) deploy "${1:?ПРИЛОЖЕНИЕ}" "${2:?SHA}" ;;
rollback) rollback "${1:?ПРИЛОЖЕНИЕ}" "${2:-}" ;;
status)
	printf 'сейчас: %s\nдо этого: %s\n' "$(cat "/state/${1:?ПРИЛОЖЕНИЕ}/current" 2>/dev/null || echo -)" \
		"$(cat "/state/$1/previous" 2>/dev/null || echo -)"
	;;
*)
	echo "команды: watch, deploy, rollback, status" >&2
	exit 2
	;;
esac
