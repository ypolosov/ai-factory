# Настройки стенда. scripts/stand-up.sh копирует этот файл в .env, если его нет.
# Пароли и токены генерирует скрипт и кладёт в .state/ (в git не попадает).

# Порт Forgejo, публикуется только на 127.0.0.1
FORGEJO_HTTP_PORT=3000

# Администратор стенда
FORGEJO_ADMIN_USER=factory-admin
FORGEJO_ADMIN_EMAIL=admin@factory.local

# Служебная учётка, от которой агенты открывают PR
FORGEJO_BOT_USER=factory-bot
FORGEJO_BOT_EMAIL=bot@factory.local

# Шлюз моделей, публикуется только на 127.0.0.1
GATEWAY_PORT=4000
# Дневной бюджет ключа агента в долларах; при превышении шлюз отказывает
GATEWAY_AGENT_DAILY_USD=2

# Что выкладывает служба выкладки: "владелец/репозиторий=порт ...", порты стенда 8080-8089
DEPLOY_APPS=factory-admin/hello=8080 factory-admin/todo=8081

# Служебная учётка, от которой проверки доступности заводят задачи о сбоях
FORGEJO_OPS_USER=factory-ops
FORGEJO_OPS_EMAIL=ops@factory.local

# Страница проверок доступности (Gatus), публикуется только на 127.0.0.1
GATUS_PORT=8100
