@startuml c4-l2-target
!include <C4/C4_Container>
!include common.puml

title C4 L2 - контейнеры целевой системы Розыгрыш призов (платформа цели: GitHub + Actions)

Person(users, "Участник", "Подаёт заявку, смотрит результаты,\nподтверждает получение приза")
Person(admin, "Организатор", "Создаёт розыгрыш: призы, период,\nчисло победителей; запускает выбор")

System_Boundary(rooms, "Розыгрыш призов") {
  Container(spa, "Веб-приложение", "TypeScript, React, Vite; nginx", "Активные розыгрыши, заявка,\nрезультаты с проверкой честности,\nкабинет организатора")
  Container(api, "API", "TypeScript, NestJS", "Розыгрыши, заявки, выбор победителей\nиз зафиксированного зерна, подтверждение\nприза, повторный розыгрыш")
  ContainerDb(db, "База", "PostgreSQL", "Розыгрыши, заявки, победители;\nодна заявка - уникальным ключом")
}

System_Ext(discord, "Discord", "Канал розыгрышей:\nобъявление победителей")
System_Ext(gh, "GitHub", "Репозиторий, Actions (CI цели),\nGHCR (образы)")
System_Ext(factory, "Фабрика ПО на ИИ", "Создаёт и меняет систему,\nвыкладывает на стенд, наблюдает")

Rel_D(users, spa, "участвует", "HTTPS")
Rel_D(admin, spa, "проводит розыгрыш", "HTTPS")
Rel_R(spa, api, "вызывает", "JSON/HTTP")
Rel_D(api, db, "читает и пишет", "SQL")
Rel_R(api, discord, "уведомления", "вебхук")
Rel_U(gh, rooms, "собирает и тестирует,\nпубликует образы")
Rel_U(factory, rooms, "выкладывает образы,\nпроверяет доступность")
Rel_R(factory, gh, "PR, статусы стражей")

SHOW_LEGEND()
@enduml
